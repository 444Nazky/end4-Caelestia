{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "cpu", "memory", "temperature", "disk", "battery", "tray"],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        }
    },

    "hyprland/window": {
        "format": " {}",
        "max-length": 50
    },

    "clock": {
        "timezone": "Asia/Jakarta",
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "interval": 2,
        "format-wifi": "直 {essid} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-ethernet": " 呂 {ipaddr}/{cidr} ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format": " {ipaddr} ",
        "format-linked": " 呂 {essid}",
        "format-disconnected": "睚 Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "cpu": {
        "interval": 2,
        "format": " 祠 {usage}%",
        "format-alt": " 祠 {avg_frequency}GHz"
    },

    "memory": {
        "interval": 2,
        "format": " 溜 {percentage}%",
        "format-alt": " 溜 {used:0.1f}G/{total:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },

    "temperature": {
        "interval": 2,
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "{icon} {temperatureC}°C",
        "format-icons": ["", "", "", "", ""]
    },

    "disk": {
        "interval": 30,
        "path": "/",
        "format": " 󰋊 {percentage_used}%",
        "tooltip-format": "{used} / {total} ({percentage_used}%)"
    },

    "battery": {
        "interval": 5,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  Plugged",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", "", "", "", "", "", ""]
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
